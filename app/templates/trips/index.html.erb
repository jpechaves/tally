<main>
  <h1><%= t("trips.index.title") %></h1>
  <p class="note"><%= t("trips.index.intro") %></p>
  <% if trips.empty? %>
    <p><%= t("trips.index.empty") %></p>
  <% else %>
    <div class="scroll"><table class="rows">
      <thead><tr><th><%= t("trips.index.name") %></th><th><%= t("trips.index.dates") %></th><th class="num"><%= t("trips.index.total") %></th></tr></thead>
      <tbody>
        <% trips.each do |trip, result| %>
          <tr>
            <td><a href="/trips/<%= trip[:id] %>"><%= trip[:name] %></a></td>
            <td><%= t("common.range", from: date(trip[:starts_on]), to: date(trip[:ends_on])) %></td>
            <td class="num"><%= money(result.total_cents) %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  <% end %>

  <h2><%= t("trips.index.new") %></h2>
  <form action="/trips" method="post">
    <p><label><%= t("trips.index.name") %><br><input name="name" size="40" required></label></p>
    <p><label><%= t("trips.index.starts_on") %><br><input type="date" name="starts_on" required></label></p>
    <p><label><%= t("trips.index.ends_on") %><br><input type="date" name="ends_on" required></label></p>
    <p><%= t("trips.index.accounts") %><br>
      <% accounts.each do |account| %><label><input type="checkbox" name="account_ids[]" value="<%= account.id %>"> <%= account.name %></label> <% end %></p>
    <button type="submit" class="primary"><%= t("common.add") %></button>
  </form>
</main>
