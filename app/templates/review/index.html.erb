<main>
  <h1><%= t("review.index.title") %></h1>
  <% if saved %><p class="notice"><%= t("review.index.saved", rows: t("common.row_count", count: saved.to_i)) %></p><% end %>
  <% if groups.empty? %>
    <p><%= t("review.index.empty") %></p>
  <% else %>
    <p><%= t("review.index.intro", uncategorized: uncategorized, suggested: suggested, groups: group_count) %></p>
    <%= render "shared/pages", page: pagination, path: page_path %>
    <% groups.each do |group| %>
      <section class="group">
        <h2><%= group.label %> · <%= t("common.row_count", count: group.rows.size) %> · <%= money(group.total_cents) %>
          <% if group.suggested_category_id %><span class="suggested">· <%= t("review.index.bank_suggests", category: category_name(group.suggested_category_name)) %></span><% end %></h2>
        <form action="/review" method="post">
          <input type="hidden" name="ids" value="<%= group.ids.join(",") %>">
          <input type="hidden" name="page" value="<%= pagination.number %>">
          <% if group.counterparty_id %>
            <input type="hidden" name="counterparty_id" value="<%= group.counterparty_id %>">
          <% else %>
            <input type="hidden" name="pattern" value="<%= group.pattern %>">
          <% end %>
          <%= render "categories/select", none: nil, name: "category_id", selected: group.suggested_category_id, categories: categories, blank: nil, form: nil %>
          <label><input type="checkbox" name="always" value="1" checked> <%= t("review.index.always", payee: group.label) %></label>
          <button type="submit"><%= t("common.save") %></button>
        </form>
        <details>
          <summary class="note"><%= t("common.rows") %></summary>
          <%= render "transactions/table", rows: group.rows %>
        </details>
      </section>
    <% end %>
    <%= render "shared/pages", page: pagination, path: page_path %>
  <% end %>
</main>
