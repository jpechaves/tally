<main>
  <h1><%= t("plans.show.title", amount: money(plan[:target_cents])) %></h1>
  <p class="note"><%= status_label(:plan, plan[:status]) %> · <%= t("plans.show.baseline", from: month_label(plan[:baseline_from]), to: month_label(plan[:baseline_to])) %> ·
    <%= t("plans.show.budgets_from", month: month_label(plan[:starts_month])) %></p>
  <div class="cards">
    <div><%= t("plans.show.income") %><strong><%= money(plan[:baseline_income_cents]) %></strong><span class="note"><%= t("plans.show.on_average") %></span></div>
    <div><%= t("plans.show.spending") %><strong><%= money(plan[:baseline_spending_cents]) %></strong><span class="note"><%= t("plans.show.on_average") %></span></div>
    <div><%= t("plans.show.saved_today") %><strong><%= money(saved_today_cents) %></strong></div>
    <div><%= t("plans.show.gap") %><strong><%= gap_cents.positive? ? money(gap_cents) : t("plans.show.no_gap") %></strong></div>
  </div>

  <% if !gap_cents.positive? %>
    <p class="notice"><%= t("plans.show.already_there", saved: money(saved_today_cents), extra: money(-gap_cents)) %></p>
  <% elsif plan[:shortfall_cents].positive? %>
    <p class="notice"><%= t("plans.show.shortfall", cuts: money(cuts_cents), shortfall: money(plan[:shortfall_cents])) %></p>
  <% end %>

  <form action="/plan/<%= plan[:id] %>/accept" method="post" id="plan">
    <table class="rows">
      <thead><tr><th><%= t("plans.show.category") %></th><th><%= t("plans.show.nature") %></th><th class="num"><%= t("plans.show.today") %></th><th class="num"><%= t("plans.show.may_cut") %></th><th class="num"><%= t("plans.show.new_limit") %></th><th class="num"><%= t("plans.show.cut") %></th></tr></thead>
      <tbody>
        <% lines.each do |line| %>
          <tr>
            <td><%= line[:parent_name] ? "#{line[:parent_name]} › " : "" %><%= line[:name] %></td>
            <td><%= nature_label(line[:nature]) %></td>
            <td class="num"><%= money(line[:baseline_cents]) %></td>
            <td class="num"><%= money(line[:max_cut_cents]) %></td>
            <td class="num">
              <% if plan[:status] == "draft" %>
                <input name="proposed[<%= line[:category_id] %>]" class="amount" value="<%= amount_field(line[:proposed_cents]) %>" data-baseline="<%= line[:baseline_cents] %>">
              <% else %>
                <%= money(line[:proposed_cents]) %>
              <% end %>
            </td>
            <td class="num" data-cut><%= money(line[:baseline_cents] - line[:proposed_cents]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p><%= t("plans.show.would_save_html", amount: money(saved_today_cents + cuts_cents)) %>
      <span id="verdict"><%= saved_today_cents + cuts_cents >= plan[:target_cents] ? t("plans.show.reaches") : t("plans.show.short") %></span>.</p>
    <% if plan[:status] == "draft" %>
      <button type="submit"><%= t("plans.show.accept", month: month_label(plan[:starts_month])) %></button>
    <% end %>
  </form>

  <% if gap_cents.positive? %>
    <h2><%= t("plans.show.levers") %></h2>
    <% unless fixed_lines.empty? %>
      <p><%= t("plans.show.fixed_lever") %></p>
      <ul>
        <% fixed_lines.each do |line| %><li><%= t("plans.show.per_month", name: line[:name], amount: money(line[:baseline_cents])) %></li><% end %>
      </ul>
    <% end %>
    <% unless ending_installments.empty? %>
      <p><%= t("plans.show.installments_lever") %></p>
      <ul>
        <% ending_installments.each do |purchase| %>
          <li><%= t("plans.show.installment_ends", name: purchase.description, amount: money(purchase.cents), month: month_label(purchase.ends)) %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <script>
    (() => {
      const form = document.getElementById("plan");
      const inputs = form.querySelectorAll("input[data-baseline]");
      if (!inputs.length) return;
      const today = <%= saved_today_cents %>, target = <%= plan[:target_cents] %>;
      const decimal = "<%= Tally::Money.decimal_mark(locale) %>", tag = "<%= locale == "en" ? "en-US" : "pt-BR" %>";
      const words = {reaches: "<%= t("plans.show.reaches") %>", short: "<%= t("plans.show.short") %>"};
      const cents = (text) => Math.round(parseFloat(text.split(decimal === "," ? "." : ",").join("").replace(decimal, ".")) * 100);
      const brl = (c) => (c < 0 ? "-" : "") + "R$ " + (Math.abs(c) / 100).toLocaleString(tag, {minimumFractionDigits: 2, maximumFractionDigits: 2});
      const update = () => {
        let cuts = 0;
        inputs.forEach((input) => {
          const value = cents(input.value);
          const cut = isNaN(value) ? 0 : Number(input.dataset.baseline) - value;
          cuts += cut;
          input.closest("tr").querySelector("[data-cut]").textContent = brl(cut);
        });
        document.getElementById("new-saved").textContent = brl(today + cuts);
        document.getElementById("verdict").textContent = today + cuts >= target ? words.reaches : words.short;
      };
      inputs.forEach((input) => input.addEventListener("input", update));
    })();
  </script>
</main>
