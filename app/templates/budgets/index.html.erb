<main>
  <h1><%= t("budgets.index.title") %></h1>
  <%= render "report/month_picker", path: "/budgets", months: months, month: month %>
  <% if error_code %><p class="error"><%= t("errors.#{error_code}", default: error_code.to_s) %></p><% end %>
  <% if plan_shortfall_cents.positive? %>
    <p class="warning"><%= t("budgets.index.plan_short", saved: money(plan[:target_cents] - plan_shortfall_cents),
      short: money(plan_shortfall_cents), target: money(plan[:target_cents])) %></p>
  <% end %>
  <% if budget_month.lines.empty? %>
    <p><%= t("budgets.index.empty_html", month: month_label(month)) %></p>
  <% else %>
    <div class="cards">
      <% if budget_month.target_cents %><div><%= t("budgets.index.target") %><strong><%= money(budget_month.target_cents) %></strong><span class="note"><%= t("budgets.index.a_month") %></span></div><% end %>
      <div><%= t("budgets.index.saved_so_far") %><strong><%= money(budget_month.saved_cents) %></strong><span class="note"><%= t("budgets.index.in_out", in: money(budget_month.income_cents), out: money(budget_month.spending_cents)) %></span></div>
      <% unless budget_month.complete? %>
        <div><%= t("budgets.index.projected") %><strong class="<%= budget_month.on_track? ? "down" : "up" %>"><%= money(budget_month.projected_saved_cents) %></strong>
          <span class="note"><%= budget_month.on_track? ? t("budgets.index.on_track") : t("plans.show.short") %></span></div>
      <% end %>
    </div>
    <p class="note">
      <% if budget_month.complete? %>
        <%= t("budgets.index.over", month: month_label(month)) %>
      <% else %>
        <%= t("budgets.index.elapsed", pct: (budget_month.elapsed * 100).round, month: month_label(month)) %>
      <% end %>
      <%= t("budgets.index.counting") %>
      <% if next_installments_cents.positive? %><%= t("budgets.index.next_installments", amount: money(next_installments_cents)) %><% end %>
    </p>

    <% if (score = budget_month.score) %>
      <p class="notice"><%= t("budgets.index.score", result: score[:hit] ? t("budgets.index.reached") : t("budgets.index.missed"), saved: money(score[:saved_cents]), target: money(score[:target_cents]), difference: money(score[:difference_cents])) %>
        <% unless score[:over].empty? %><%= t("budgets.index.over_budget", names: score[:over].map { "#{category_name(_1.name)} (#{money(-_1.left_cents)})" }.join(", ")) %><% end %></p>
    <% end %>

    <div class="scroll"><table class="rows">
      <thead><tr><th><%= t("budgets.index.category") %></th><th class="num"><%= t("budgets.index.spent") %></th><th class="num"><%= t("budgets.index.limit") %></th><th class="num"><%= t("budgets.index.left") %></th><th class="num"><%= t("budgets.index.pace") %></th><th></th><th></th></tr></thead>
      <tbody>
        <% budget_month.lines.each do |line| %>
          <tr>
            <td><%= category_path(line.parent_name, line.name) %>
              <div class="meter<%= " over" if line.over? %>" title="<%= money(line.spent_cents) %> / <%= money(line.limit_cents) %>">
                <span style="width: <%= bar_percent(line.spent_cents, line.limit_cents) %>%"></span><% unless budget_month.complete? %><i style="left: <%= (budget_month.elapsed * 100).round(1).to_f %>%"></i><% end %>
              </div></td>
            <td class="num"><%= money(line.spent_cents) %></td>
            <td class="num">
              <form action="/budgets" method="post" class="inline">
                <input type="hidden" name="category_id" value="<%= line.category_id %>">
                <input type="hidden" name="month" value="<%= month %>">
                <input name="amount" class="amount" value="<%= amount_field(line.limit_cents) %>" aria-label="<%= t("budgets.index.limit") %>">
              </form>
            </td>
            <td class="num<%= line.over? ? " up" : "" %>"><%= money(line.left_cents) %></td>
            <td class="num<%= line.ahead_of_pace? ? " up" : "" %>"><%= line.pace_pct ? "#{line.pace_pct}%" : "" %></td>
            <td class="warning"><%= line.over? ? t("budgets.index.over_flag") : (line.ahead_of_pace? ? t("budgets.index.ahead_flag") : "") %></td>
            <td>
              <form action="/budgets/remove" method="post" data-confirm="<%= t("budgets.index.confirm_remove", name: category_name(line.name), month: month_label(month)) %>">
                <input type="hidden" name="category_id" value="<%= line.category_id %>">
                <input type="hidden" name="month" value="<%= month %>">
                <button type="submit" class="danger"><%= t("budgets.index.remove") %></button>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
    <p class="note"><%= t("budgets.index.pace_note", month: month_label(month), amount: money(budget_month.unbudgeted_cents)) %>
      <%= t("budgets.index.remove_note", month: month_label(month)) %></p>
    <form action="/budgets/remove" method="post" data-confirm="<%= t("budgets.index.confirm_clear", month: month_label(month)) %>">
      <input type="hidden" name="all" value="1">
      <input type="hidden" name="month" value="<%= month %>">
      <button type="submit" class="danger"><%= t("budgets.index.clear", month: month_label(month)) %></button>
    </form>
  <% end %>

  <h2><%= t("budgets.index.add") %></h2>
  <form action="/budgets" method="post" class="inline">
    <input type="hidden" name="month" value="<%= month %>">
    <select name="category_id" required>
      <% expense_categories.each do |category| %><option value="<%= category[:id] %>"><%= category_path(category[:parent_name], category[:name]) %></option><% end %>
    </select>
    <label>R$ <input name="amount" class="amount" required></label>
    <button type="submit"><%= t("common.save") %></button>
  </form>

  <% unless scores.empty? %>
    <h2><%= t("budgets.index.scores") %></h2>
    <div class="scroll"><table class="rows">
      <thead><tr><th><%= t("budgets.index.month") %></th><th class="num"><%= t("budgets.index.saved") %></th><th class="num"><%= t("budgets.index.target") %></th><th><%= t("budgets.index.result") %></th><th><%= t("budgets.index.over_column") %></th></tr></thead>
      <tbody>
        <% scores.each do |value, score| %>
          <% next unless score %>
          <tr>
            <td><a href="/budgets?month=<%= value %>"><%= month_label(value) %></a></td>
            <td class="num"><%= money(score[:saved_cents]) %></td>
            <td class="num"><%= money(score[:target_cents]) %></td>
            <td class="<%= score[:hit] ? "down" : "up" %>"><%= score[:hit] ? t("budgets.index.reached_short") : t("budgets.index.missed_by", amount: money(-score[:difference_cents])) %></td>
            <td><%= score[:over].map { category_name(_1.name) }.join(", ") %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  <% end %>
</main>
