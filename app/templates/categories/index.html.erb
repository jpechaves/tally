<main>
  <h1><%= t("categories.index.title") %></h1>
  <% if error_code %><p class="error"><%= t("errors.#{error_code}", default: error_code.to_s) %></p><% end %>
  <p><%= t("categories.index.intro") %></p>
  <table class="rows">
    <thead><tr><th><%= t("categories.index.category") %></th><th><%= t("categories.index.nature") %></th><th class="num"><%= t("categories.index.max_cut") %></th><th class="num"><%= t("common.rows") %></th><th class="num"><%= t("common.net") %></th><th><%= t("categories.index.archived") %></th><th></th></tr></thead>
    <tbody>
      <% categories.each do |category| %>
        <% form = "category-#{category[:id]}" %>
        <tr class="<%= "missing" if category[:archived_at] %>">
          <td><%= category[:parent_id] ? "#{category_name(category[:parent_name])} › " : "" %><input name="name" value="<%= category_name(category[:name]) %>" form="<%= form %>" size="22"></td>
          <td>
            <% if category[:kind] == "expense" %>
              <select name="nature" form="<%= form %>">
                <option value=""><%= t("categories.index.no_nature") %></option>
                <% natures.each do |nature| %>
                  <option value="<%= nature %>"<%= " selected" if nature == category[:nature] %>><%= nature_label(nature) %></option>
                <% end %>
              </select>
            <% else %>
              <%= status_label(:category, "income") %>
            <% end %>
          </td>
          <td class="num"><% if category[:kind] == "expense" %><input name="max_cut_pct" type="number" min="0" max="100" value="<%= category[:max_cut_pct] %>" form="<%= form %>" style="width: 4em"><% end %></td>
          <td class="num"><%= category[:rows] %></td>
          <td class="num"><%= money(category[:total_cents]) %></td>
          <td><input type="checkbox" name="archived" value="1" form="<%= form %>"<%= " checked" if category[:archived_at] %>></td>
          <td><form id="<%= form %>" action="/categories/<%= category[:id] %>" method="post"><button type="submit"><%= t("common.save") %></button></form></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h2><%= t("categories.index.add") %></h2>
  <form action="/categories" method="post" class="inline">
    <input name="name" placeholder="<%= t("categories.index.name") %>" required>
    <select name="parent_id">
      <option value=""><%= t("categories.index.top_level") %></option>
      <% parents.each do |parent| %>
        <option value="<%= parent[:id] %>"><%= t("categories.index.under", parent: category_name(parent[:name])) %></option>
      <% end %>
    </select>
    <select name="kind">
      <option value="expense"><%= status_label(:category, "expense") %></option>
      <option value="income"><%= status_label(:category, "income") %></option>
    </select>
    <select name="nature">
      <option value=""><%= t("categories.index.nature_prompt") %></option>
      <% natures.each do |nature| %><option value="<%= nature %>"><%= nature_label(nature) %></option><% end %>
    </select>
    <button type="submit"><%= t("common.add") %></button>
  </form>
  <p class="note"><%= t("categories.index.kind_note") %></p>
</main>
