<main>
  <h1>Rules</h1>
  <% if error_message %><p class="error"><%= error_message %></p><% end %>
  <p>Rules run lowest priority first, and the first match picks the category. A counterparty's default (set from the
    review list) comes before any rule. Text is compared without accents and ignoring case. Seed rules are generic;
    rules about your own payees stay in your database only.</p>
  <table class="rows">
    <thead><tr><th class="num">Priority</th><th>When</th><th>Amount</th><th>Category</th><th>Origin</th><th class="num">Rows</th><th></th></tr></thead>
    <tbody>
      <% rules.each do |rule| %>
        <tr>
          <td class="num"><%= rule[:priority] %></td>
          <td><%= fields.fetch(rule[:field], rule[:field]) %> <%= operators.fetch(rule[:operator], rule[:operator]) %> <code><%= rule[:pattern] %></code></td>
          <td class="details"><%= [rule[:amount_min_cents] && "from #{money(rule[:amount_min_cents])}", rule[:amount_max_cents] && "up to #{money(rule[:amount_max_cents])}"].compact.join(" ") %></td>
          <td><%= rule[:category_name] %></td>
          <td><%= rule[:origin] %></td>
          <td class="num"><%= rule[:hits] %></td>
          <td><form action="/rules/<%= rule[:id] %>/disable" method="post"><button type="submit">Remove</button></form></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h2>Add a rule</h2>
  <form action="/rules" method="post" class="inline">
    <select name="field">
      <% fields.each do |value, label| %><option value="<%= value %>"><%= label %></option><% end %>
    </select>
    <select name="operator">
      <% operators.each do |value, label| %><option value="<%= value %>"><%= label %></option><% end %>
    </select>
    <input name="pattern" placeholder="text to match" required>
    <%= render "categories/select", name: "category_id", selected: nil, categories: categories, blank: nil, form: nil %>
    <input name="amount_min" placeholder="min amount" size="10">
    <input name="amount_max" placeholder="max amount" size="10">
    <input name="priority" type="number" min="0" value="100" style="width: 5em" title="priority">
    <button type="submit">Add</button>
  </form>
  <p class="note">Every row that isn't set by hand is categorized again when you add or remove a rule.</p>
</main>
