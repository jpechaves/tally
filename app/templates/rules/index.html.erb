<main>
  <h1><%= t("rules.index.title") %></h1>
  <% if error_code %><p class="error"><%= t("errors.#{error_code}", default: error_code.to_s) %></p><% end %>
  <p><%= t("rules.index.intro") %></p>
  <div class="scroll"><table class="rows">
    <thead><tr><th class="num"><%= t("rules.index.priority") %></th><th><%= t("rules.index.when") %></th><th><%= t("rules.index.amount") %></th><th><%= t("rules.index.category") %></th><th><%= t("rules.index.origin") %></th><th class="num"><%= t("common.rows") %></th><th></th></tr></thead>
    <tbody>
      <% rules.each do |rule| %>
        <tr>
          <td class="num"><%= rule[:priority] %></td>
          <td><%= t("rules.fields.#{rule[:field]}", default: rule[:field]) %> <%= t("rules.operators.#{rule[:operator]}", default: rule[:operator]) %> <code><%= rule[:pattern] %></code></td>
          <td class="details"><%= [rule[:amount_min_cents] && t("rules.index.from", amount: money(rule[:amount_min_cents])), rule[:amount_max_cents] && t("rules.index.up_to", amount: money(rule[:amount_max_cents]))].compact.join(" ") %></td>
          <td><%= category_name(rule[:category_name]) %></td>
          <td><%= status_label(:rule, rule[:origin]) %></td>
          <td class="num"><%= rule[:hits] %></td>
          <td><form action="/rules/<%= rule[:id] %>/disable" method="post"><button type="submit"><%= t("common.remove") %></button></form></td>
        </tr>
      <% end %>
    </tbody>
  </table></div>

  <h2><%= t("rules.index.add") %></h2>
  <form action="/rules" method="post" class="inline">
    <select name="field">
      <% fields.each do |value| %><option value="<%= value %>"><%= t("rules.fields.#{value}") %></option><% end %>
    </select>
    <select name="operator">
      <% operators.each do |value| %><option value="<%= value %>"><%= t("rules.operators.#{value}") %></option><% end %>
    </select>
    <input name="pattern" placeholder="<%= t("rules.index.pattern") %>" required>
    <%= render "categories/select", name: "category_id", selected: nil, categories: categories, blank: nil, form: nil %>
    <input name="amount_min" placeholder="<%= t("rules.index.amount_min") %>" size="10">
    <input name="amount_max" placeholder="<%= t("rules.index.amount_max") %>" size="10">
    <input name="priority" type="number" min="0" value="100" style="width: 5em" title="<%= t("rules.index.priority") %>">
    <button type="submit"><%= t("common.add") %></button>
  </form>
  <p class="note"><%= t("rules.index.note") %></p>
</main>
