<main>
  <h1><%= t("cuts.index.title") %></h1>
  <% if month.nil? %>
    <p><%= t("common.nothing_imported_html") %></p>
  <% else %>
    <%= render "report/month_picker", path: "/cuts", months: months, month: month %>
    <% if suggestions.empty? %>
      <p><%= t("cuts.index.empty", month: month_label(month)) %></p>
    <% else %>
      <p><%= t("cuts.index.intro", count: suggestions.size, month: month_label(month)) %></p>
      <% suggestions.each do |suggestion| %>
        <% title = cut_text(suggestion, :title) %>
        <section class="group">
          <h2><%= title %> <span class="note">· <%= t("cuts.signals.#{suggestion.signal}.name") %> · <%= t("cuts.index.about", amount: money(suggestion.monthly_cents)) %></span></h2>
          <p class="note"><%= cut_text(suggestion, :detail) %></p>
          <form action="/cuts/dismiss" method="post" class="inline">
            <input type="hidden" name="key" value="<%= suggestion.key %>">
            <input type="hidden" name="title" value="<%= title %>">
            <input type="hidden" name="month" value="<%= month %>">
            <button type="submit"><%= t("common.dismiss") %></button>
          </form>
        </section>
      <% end %>
    <% end %>
  <% end %>

  <% unless dismissed.empty? %>
    <h2><%= t("cuts.index.dismissed") %></h2>
    <table class="rows">
      <% dismissed.each do |item| %>
        <tr>
          <td><%= item[:title] %></td>
          <td class="note"><%= timestamp(item[:created_at]) %></td>
          <td><form action="/cuts/<%= item[:id] %>/restore" method="post"><input type="hidden" name="month" value="<%= month %>"><button type="submit"><%= t("cuts.index.restore") %></button></form></td>
        </tr>
      <% end %>
    </table>
  <% end %>
</main>
