<main>
  <h1>What can I cut?</h1>
  <% if month.nil? %>
    <p>Nothing imported yet.</p>
  <% else %>
    <%= render "report/month_picker", path: "/cuts", months: months, month: month %>
    <% if suggestions.empty? %>
      <p>No suggestions for <%= month %>.</p>
    <% else %>
      <p><%= suggestions.size %> suggestions for <%= month %>, biggest first. Estimates are per month and overlap (a recurring
        charge can also be in a big category), so they don't add up to a total. Dismiss one and it stays hidden.</p>
      <% suggestions.each do |suggestion| %>
        <section class="group">
          <h2><%= suggestion.title %> <span class="note">· <%= signals.fetch(suggestion.signal) %> · about <%= money(suggestion.monthly_cents) %> a month</span></h2>
          <p class="note"><%= suggestion.detail %></p>
          <form action="/cuts/dismiss" method="post" class="inline">
            <input type="hidden" name="key" value="<%= suggestion.key %>">
            <input type="hidden" name="title" value="<%= suggestion.title %>">
            <input type="hidden" name="month" value="<%= month %>">
            <button type="submit">Dismiss</button>
          </form>
        </section>
      <% end %>
    <% end %>
  <% end %>

  <% unless dismissed.empty? %>
    <h2>Dismissed</h2>
    <table class="rows">
      <% dismissed.each do |item| %>
        <tr>
          <td><%= item[:title] %></td>
          <td class="note"><%= timestamp(item[:created_at]) %></td>
          <td><form action="/cuts/<%= item[:id] %>/restore" method="post"><button type="submit">Show again</button></form></td>
        </tr>
      <% end %>
    </table>
  <% end %>
</main>
