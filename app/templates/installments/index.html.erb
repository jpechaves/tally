<main>
  <h1><%= t("installments.index.title") %></h1>
  <% if calendar.purchases.empty? %>
    <p><%= t("installments.index.empty") %></p>
  <% else %>
    <p><%= t("installments.index.intro", amount: money(calendar.total_cents), month: month_label(calendar.from), purchases: t("installments.index.purchases", count: calendar.purchases.size)) %></p>
    <section class="chart">
      <h2><%= t("installments.index.chart") %></h2>
      <%= columns_chart(
        title: t("installments.index.chart"),
        labels: calendar.months.keys.map { month_label(_1) },
        series: [{name: t("installments.index.committed"), css: "s-spending", values: calendar.months.values}]
      ) %>
    </section>
    <table class="rows">
      <thead><tr><th><%= t("installments.index.month") %></th><th class="num"><%= t("installments.index.committed") %></th><th class="num"><%= t("installments.index.freed") %></th></tr></thead>
      <tbody>
        <% previous = nil %>
        <% calendar.months.each do |value, cents| %>
          <tr>
            <td><%= month_label(value) %></td>
            <td class="num"><%= money(cents) %></td>
            <td class="num down"><%= previous && previous > cents ? money(previous - cents) : "" %></td>
          </tr>
          <% previous = cents %>
        <% end %>
      </tbody>
    </table>

    <h2><%= t("installments.index.purchases_title") %></h2>
    <table class="rows">
      <thead><tr><th><%= t("installments.index.purchase") %></th><th><%= t("installments.index.card") %></th><th><%= t("installments.index.paid") %></th><th><%= t("installments.index.last_one") %></th><th class="num"><%= t("installments.index.each") %></th><th class="num"><%= t("installments.index.left_from", month: month_label(calendar.from)) %></th></tr></thead>
      <tbody>
        <% calendar.purchases.each do |purchase| %>
          <tr>
            <td><%= purchase.description %></td>
            <td><%= purchase.account_name %></td>
            <td><%= purchase.number %>/<%= purchase.total %></td>
            <td><%= month_label(purchase.ends) %></td>
            <td class="num"><%= money(purchase.cents) %></td>
            <td class="num"><%= money(purchase.cents * purchase.left_from(calendar.from)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% unless bills.empty? %>
    <h2><%= t("installments.index.banks") %></h2>
    <table class="rows">
      <thead><tr><th><%= t("installments.index.card") %></th><th><%= t("installments.index.latest_due") %></th><th class="num"><%= t("installments.index.next_bill") %></th><th class="num"><%= t("installments.index.later_bills") %></th></tr></thead>
      <tbody>
        <% bills.each do |bill| %>
          <tr>
            <td><%= bill[:account_name] %></td>
            <td><%= date(bill[:due_on]) %></td>
            <td class="num"><%= bill[:next_statement_cents] ? money(bill[:next_statement_cents]) : t("installments.index.not_printed") %></td>
            <td class="num"><%= bill[:later_statements_cents] ? money(bill[:later_statements_cents]) : "" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="note"><%= t("installments.index.banks_note") %></p>
  <% end %>
</main>
