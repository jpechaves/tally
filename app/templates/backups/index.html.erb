<main>
  <h1><%= t("backups.index.title") %></h1>
  <% if dir.nil? %>
    <p><%= t("backups.index.none_html") %></p>
  <% else %>
    <%= render "shared/backup_warning", status: status, run: last_run, link: false %>
    <% if last_run %>
      <div class="cards">
        <div><%= t("backups.index.last_run") %><strong><%= timestamp(last_run.time.iso8601) %></strong>
          <span class="note"><%= t("backups.kinds.#{last_run.kind}", default: last_run.kind) %> · <%= last_run.ok? ? t("backups.index.check_ok") : t("backups.index.check_failed", check: last_run.check) %></span></div>
      </div>
    <% end %>
    <h2><%= t("backups.index.copies") %></h2>
    <% if copies.empty? %>
      <p class="note"><%= t("backups.index.no_copies") %></p>
    <% else %>
      <div class="scroll"><table>
        <thead><tr><th><%= t("backups.index.date") %></th><th><%= t("backups.index.kind") %></th><th><%= t("backups.index.file") %></th><th class="num"><%= t("backups.index.size") %></th></tr></thead>
        <tbody>
          <% copies.each do |copy| %>
            <tr>
              <td><%= timestamp(copy.time.utc.iso8601) %></td>
              <td><%= t("backups.kinds.#{copy.kind}", default: copy.kind) %></td>
              <td><% if downloads_on %><a href="/backups/<%= copy.file %>" download><%= copy.file %></a><% else %><%= copy.file %><% end %></td>
              <td class="num"><%= file_size(copy.bytes) %></td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    <% end %>
    <% unless downloads_on %><p class="note"><%= t("backups.index.downloads_off") %></p><% end %>
    <p class="note"><%= t("backups.index.folder") %> <code><%= dir %></code>. <%= t("backups.index.keep_html") %></p>
  <% end %>
</main>
