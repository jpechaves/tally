<tr<% unless css.empty? %> class="<%= css %>"<% end %>>
  <td><%= label %></td>
  <td class="num"><%= money(line.cents) %></td>
  <td class="num"><%= number(line.share) %>%</td>
  <td class="num"><%= money(line.average_cents) %></td>
  <td class="num<% if line.change %> <%= line.change.positive? ? "up" : "down" %><% end %>"><%= line.change ? "#{"+" if line.change.positive?}#{number(line.change)}%" : "" %></td>
  <td class="num"><%= line.rows %></td>
</tr>
