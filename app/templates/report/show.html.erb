<main>
  <h1><%= t("report.show.title") %></h1>
  <% if report.nil? %>
    <p><%= t("common.nothing_imported_html") %></p>
  <% else %>
    <%= render "report/month_picker", path: "/report", months: months, month: month %>
    <% averaged = report.averaged_months %>
    <div class="cards">
      <div><%= t("report.show.income") %><strong><%= money(report.income_cents) %></strong><span class="note"><%= t("report.show.average_of", amount: money(report.average_income_cents)) %></span></div>
      <div><%= t("report.show.spending") %><strong><%= money(report.spending_cents) %></strong><span class="note"><%= t("report.show.average_of", amount: money(report.average_spending_cents)) %></span></div>
      <div><%= t("report.show.saved") %><strong class="<%= report.saved_cents.negative? ? "up" : "down" %>"><%= money(report.saved_cents) %></strong><span class="note"><%= t("report.show.average_of", amount: money(report.average_saved_cents)) %></span></div>
    </div>
    <p class="note"><% if averaged.empty? %><%= t("report.show.no_average") %><% else %><%= t("report.show.averages_over", months: averaged.map { month_label(_1) }.join(", ")) %><% end %>
      <%= t("report.show.counting") %>
      <% unless foreign_accounts.empty? %><%= t("report.show.foreign_accounts") %>
        <% foreign_accounts.each_with_index do |account, index| %><%= ", " if index.positive? %><a href="/accounts/<%= account.id %>/report"><%= account.name %></a><% end %>.<% end %>
      <% if hide_trips %><%= " " %><%= t("report.show.trips_hidden") %> <a href="/report?month=<%= month %>"><%= t("report.show.show_trips") %></a>
      <% elsif any_trips %><%= " " %><a href="/report?month=<%= month %>&amp;trips=hide"><%= t("report.show.hide_trips") %></a><% end %></p>

    <%= render "charts/trend", currency: Tally::Money::DEFAULT_CURRENCY, title: t("report.show.trend"), trend: trend, month: month %>

    <h2><%= t("report.show.by_category") %></h2>
    <div class="scroll"><table class="rows">
      <%= render "report/head", first: t("report.show.category") %>
      <tbody>
        <% report.categories.each do |line| %>
          <%= render "report/line", currency: Tally::Money::DEFAULT_CURRENCY, line: line, label: category_name(line.name) || t("report.show.uncategorized"), css: "",
            href: transactions_path(month: month, kind: "spending", category: line.id || Tally::TransactionFilter::NONE) %>
          <% line.children.each do |child| %>
            <%= render "report/line", currency: Tally::Money::DEFAULT_CURRENCY, line: child, label: category_name(child.name), css: "child",
              href: transactions_path(month: month, kind: "spending", category: child.id) %>
          <% end %>
        <% end %>
      </tbody>
    </table></div>
    <p class="note"><%= t("report.show.uncategorized_note_html", name: t("report.show.uncategorized")) %></p>

    <h2><%= t("report.show.by_nature") %></h2>
    <div class="scroll"><table class="rows">
      <%= render "report/head", first: t("report.show.nature") %>
      <tbody>
        <% report.natures.each do |line| %><%= render "report/line", currency: Tally::Money::DEFAULT_CURRENCY, line: line, label: nature_label(line.name == Tally::TransactionFilter::UNSET ? nil : line.name), css: "",
          href: transactions_path(month: month, kind: "spending", nature: line.name) %><% end %>
      </tbody>
    </table></div>

    <h2><%= t("report.show.top_payees") %></h2>
    <div class="scroll"><table class="rows">
      <%= render "report/head", first: t("report.show.payee") %>
      <tbody>
        <% report.payees.each do |line| %><%= render "report/line", currency: Tally::Money::DEFAULT_CURRENCY, line: line, label: line.name, css: "",
          href: transactions_path(month: month, kind: "spending", payee: line.id) %><% end %>
      </tbody>
    </table></div>

    <h2><%= t("report.show.installments") %></h2>
    <% if report.installments.empty? %>
      <p><%= t("common.none") %></p>
    <% else %>
      <p><%= t("report.show.installments_summary", amount: money(report.installments_cents), count: report.installments.size) %>
        <a href="/installments"><%= t("report.show.committed_next") %></a>.</p>
      <div class="scroll"><table class="rows">
        <thead><tr><th><%= t("report.show.purchase") %></th><th><%= t("report.show.installment") %></th><th><%= t("report.show.ends") %></th><th class="num"><%= t("report.show.amount") %></th></tr></thead>
        <tbody>
          <% report.installments.each do |item| %>
            <tr>
              <td><a href="<%= transactions_path(purchase: item[:row][:id]) %>"><%= item[:row][:description] %></a> <span class="note"><%= item[:row][:account_name] %></span></td>
              <td><%= item[:row][:installment_number] %>/<%= item[:row][:installment_total] %></td>
              <td><%= item[:left].zero? ? t("report.show.this_month") : month_label(item[:ends]) %></td>
              <td class="num"><%= money(item[:cents]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    <% end %>
  <% end %>
</main>
