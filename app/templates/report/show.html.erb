<main>
  <h1>Where the money went</h1>
  <% if report.nil? %>
    <p>Nothing imported yet. Start by <a href="/imports">importing your statements</a>.</p>
  <% else %>
    <%= render "report/month_picker", path: "/report", months: months, month: month %>
    <% averaged = report.averaged_months %>
    <div class="cards">
      <div>Income<strong><%= money(report.income_cents) %></strong><span class="note">average <%= money(report.average_income_cents) %></span></div>
      <div>Spending<strong><%= money(report.spending_cents) %></strong><span class="note">average <%= money(report.average_spending_cents) %></span></div>
      <div>Saved<strong class="<%= report.saved_cents.negative? ? "up" : "down" %>"><%= money(report.saved_cents) %></strong><span class="note">average <%= money(report.average_saved_cents) %></span></div>
    </div>
    <p class="note"><% if averaged.empty? %>No earlier months imported, so there is no average yet.<% else %>Averages over <%= averaged.join(", ") %>.<% end %>
      Card purchases count in the month they were made; installments in the month of their bill. Transfers between your accounts are left out.</p>

    <h2>By category</h2>
    <table class="rows">
      <thead><tr><th>Category</th><th class="num">Spent</th><th class="num">Share</th><th class="num">Average</th><th class="num">Change</th><th class="num">Rows</th></tr></thead>
      <tbody>
        <% report.categories.each do |line| %>
          <%= render "report/line", line: line, css: "" %>
          <% line.children.each do |child| %>
            <%= render "report/line", line: child, css: "child" %>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <p class="note">Rows without a category are under "Sem categoria"; the <a href="/review">review list</a> sorts them out.</p>

    <h2>By nature</h2>
    <table class="rows">
      <thead><tr><th>Nature</th><th class="num">Spent</th><th class="num">Share</th><th class="num">Average</th><th class="num">Change</th><th class="num">Rows</th></tr></thead>
      <tbody>
        <% report.natures.each do |line| %><%= render "report/line", line: line, css: "" %><% end %>
      </tbody>
    </table>

    <h2>Top payees</h2>
    <table class="rows">
      <thead><tr><th>Payee</th><th class="num">Spent</th><th class="num">Share</th><th class="num">Average</th><th class="num">Change</th><th class="num">Rows</th></tr></thead>
      <tbody>
        <% report.payees.each do |line| %><%= render "report/line", line: line, css: "" %><% end %>
      </tbody>
    </table>

    <h2>Card installments this month</h2>
    <% if report.installments.empty? %>
      <p>None.</p>
    <% else %>
      <p><%= money(report.installments_cents) %> of this month's spending, <%= report.installments.size %> installments.
        <a href="/installments">What's committed next</a>.</p>
      <table class="rows">
        <thead><tr><th>Purchase</th><th>Installment</th><th>Ends</th><th class="num">Amount</th></tr></thead>
        <tbody>
          <% report.installments.each do |item| %>
            <tr>
              <td><%= item[:row][:description] %> <span class="note"><%= item[:row][:account_name] %></span></td>
              <td><%= item[:row][:installment_number] %>/<%= item[:row][:installment_total] %></td>
              <td><%= item[:left].zero? ? "this month" : item[:ends] %></td>
              <td class="num"><%= money(item[:cents]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
</main>
