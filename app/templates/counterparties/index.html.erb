<main>
  <h1><%= t("counterparties.index.title") %></h1>
  <p><%= t("counterparties.index.intro") %></p>
  <form action="/counterparties" method="get" class="filters">
    <input type="search" name="q" value="<%= search %>" placeholder="<%= t("counterparties.index.search") %>" aria-label="<%= t("counterparties.index.search") %>">
    <button type="submit"><%= t("common.show") %></button>
    <% unless search.empty? %><a href="/counterparties"><%= t("counterparties.index.clear") %></a><% end %>
  </form>

  <% if counterparties.empty? %>
    <p><%= search.empty? ? t("counterparties.index.empty") : t("counterparties.index.no_match", search: search) %></p>
  <% else %>
    <p><%= t("counterparties.index.count", count: pagination.total) %></p>
    <%= render "shared/pages", page: pagination, path: page_path %>
    <div class="scroll"><table>
      <thead><tr><th><%= t("counterparties.index.name") %></th><th><%= t("counterparties.index.document") %></th><th><%= t("counterparties.index.bank") %></th><th class="num"><%= t("common.rows") %></th><th class="num"><%= t("common.net") %></th><th></th></tr></thead>
      <tbody>
        <% counterparties.each do |party| %>
          <tr>
            <td><span class="name"><%= party[:display_name] || party[:name] %></span><%= person_label(party, people) %>
              <% if party[:display_name] %><br><span class="note" title="<%= t("counterparties.index.bank_name") %>"><%= party[:name] %></span><% end %>
              <% if party[:note] %><br><span class="note"><%= party[:note] %></span><% end %>
              <details>
                <summary class="note"><%= t("counterparties.index.edit") %></summary>
                <%= render "counterparties/label_form", party: party, back: page_path.(pagination.number) %>
              </details></td>
            <td><%= party[:document] %></td>
            <td><%= party[:bank_name] %></td>
            <td class="num"><% if party[:rows].positive? %><a href="<%= transactions_path(payee: "counterparty:#{party[:id]}") %>"><%= party[:rows] %></a><% else %>0<% end %></td>
            <td class="num"><%= money(party[:total_cents]) %></td>
            <td>
              <% if party[:document_kind] == "cpf_masked" || party[:is_self] == 1 %>
                <form action="/counterparties/<%= party[:id] %>/self" method="post">
                  <input type="hidden" name="q" value="<%= search %>">
                  <input type="hidden" name="page" value="<%= pagination.number %>">
                  <% if people.one? %>
                    <input type="hidden" name="person" value="<%= party[:is_self] == 1 ? "" : people.first.id %>">
                    <button type="submit"><%= party[:is_self] == 1 ? t("counterparties.index.not_me") : t("counterparties.index.this_is_me") %></button>
                  <% else %>
                    <select name="person" aria-label="<%= t("counterparties.index.who") %>">
                      <option value=""><%= t("counterparties.index.no_one") %></option>
                      <% people.each do |person| %>
                        <option value="<%= person.id %>"<%= " selected" if person.id == party[:person_id] %>><%= person.name %></option>
                      <% end %>
                    </select>
                    <button type="submit"><%= t("common.save") %></button>
                  <% end %>
                </form>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
    <%= render "shared/pages", page: pagination, path: page_path %>
  <% end %>
</main>
