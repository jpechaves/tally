<main>
  <h1><%= party[:display_name] || party[:name] %></h1>
  <p class="note"><%= t("counterparties.show.bank_name", name: party[:name]) %><% if party[:document] %> · <%= party[:document] %><% end %></p>
  <%= render "counterparties/label_form", party: party, back: back %>
  <form action="/subscriptions/marks" method="post">
    <input type="hidden" name="key" value="counterparty:<%= party[:id] %>"><input type="hidden" name="kind" value="marked">
    <input type="hidden" name="title" value="<%= party[:display_name] || party[:name] %>"><input type="hidden" name="back" value="/counterparties/<%= party[:id] %>">
    <button type="submit"><%= t("counterparties.show.subscription") %></button> <span class="note"><%= t("counterparties.show.subscription_note") %></span>
  </form>
  <p><a href="<%= transactions_path(payee: "counterparty:#{party[:id]}") %>"><%= t("counterparties.show.transactions") %></a>
    <% if back %> · <a href="<%= back %>"><%= t("counterparties.show.back") %></a><% end %></p>
</main>
