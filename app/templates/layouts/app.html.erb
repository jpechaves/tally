<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tally</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 72rem; margin: 1.5rem auto; padding: 0 1rem; color: #1f2328; }
      nav { display: flex; gap: 1rem; padding-bottom: .75rem; margin-bottom: 1rem; border-bottom: 1px solid #d0d7de; }
      nav a { color: #0969da; text-decoration: none; }
      table { border-collapse: collapse; }
      th, td { text-align: left; padding: .25rem 1rem .25rem 0; vertical-align: top; }
      th { font-weight: 500; color: #57606a; }
      table.rows td { border-top: 1px solid #eaeef2; }
      .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .details, .note { color: #57606a; font-size: .9em; }
      tr.missing td { text-decoration: line-through; color: #8c959f; }
      .error, .status-rejected, .check-warning, .warning { color: #cf222e; }
      .status-applied, .check-ok { color: #1a7f37; }
      .filters { display: flex; gap: .5rem; margin-bottom: 1rem; }
      .group { border-top: 1px solid #d0d7de; padding: .75rem 0; }
      .group h2 { font-size: 1rem; margin: 0 0 .5rem; }
      .group form, form.inline { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
      .suggested { color: #9a6700; }
      .up { color: #cf222e; }
      .down { color: #1a7f37; }
      .cards { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 1rem; }
      .cards div { min-width: 10rem; }
      .cards strong { display: block; font-size: 1.4rem; font-variant-numeric: tabular-nums; }
      tr.child td:first-child { padding-left: 1.5rem; }
      input.amount { width: 7em; text-align: right; }
      .notice { background: #fff8c5; padding: .5rem .75rem; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/"><strong>Tally</strong></a>
      <a href="/imports">Import</a>
      <a href="/accounts">Accounts</a>
      <a href="/transactions">Transactions</a>
      <a href="/report">Report</a>
      <a href="/cuts">Cuts</a>
      <a href="/installments">Installments</a>
      <a href="/plan">Plan</a>
      <a href="/budgets">Budgets</a>
      <a href="/review">Review</a>
      <a href="/categories">Categories</a>
      <a href="/rules">Rules</a>
      <a href="/counterparties">Counterparties</a>
    </nav>
    <%= yield %>
  </body>
</html>
