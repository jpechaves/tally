<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <title>Tally</title>
    <link rel="stylesheet" href="/assets/app.css">
    <script src="/assets/confirm.js" defer></script>
    <script src="/assets/picker.js" defer></script>
  </head>
  <body data-picker-empty="<%= t("common.no_match") %>">
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">T</span>Tally</a>
        <% [
          [:overview, [["/", :home], ["/report", :report], ["/cuts", :cuts], ["/subscriptions", :subscriptions], ["/installments", :installments], ["/trips", :trips]]],
          [:planning, [["/plan", :plan], ["/budgets", :budgets]]],
          [:data, [["/transactions", :transactions], ["/accounts", :accounts], ["/imports", :imports]]],
          [:organize, [["/review", :review], ["/categories", :categories], ["/rules", :rules], ["/counterparties", :counterparties]]]
        ].each do |group, links| %>
          <nav class="nav-group" aria-label="<%= t("layout.groups.#{group}") %>">
            <h2><%= t("layout.groups.#{group}") %></h2>
            <% links.each do |path, key| %>
              <% current = path == "/" ? request.path == "/" : (request.path == path || request.path.start_with?("#{path}/")) %>
              <% if current %><a href="<%= path %>" aria-current="page"><% else %><a href="<%= path %>"><% end %><%= t("layout.nav.#{key}") %></a>
            <% end %>
          </nav>
        <% end %>
        <form action="/locale" method="post">
          <input type="hidden" name="back" value="<%= request.fullpath %>">
          <% Tally::Locales::NAMES.each do |code, name| %>
            <% next if code == locale %>
            <button type="submit" name="locale" value="<%= code %>" lang="<%= code %>"><%= name %></button>
          <% end %>
        </form>
      </aside>
      <%= yield %>
    </div>
  </body>
</html>
