<table class="rows">
  <thead>
    <tr><th>Date</th><th>Account</th><th>Description</th><th>Kind</th><th>Details</th><th class="num">Amount</th></tr>
  </thead>
  <tbody>
    <% rows.each do |row| %>
      <tr class="<%= "missing" if row[:missing_since_import_id] %>">
        <td><%= row[:occurred_on] %></td>
        <td><%= row[:account_name] %></td>
        <td title="<%= row[:raw_description] %>"><%= row[:description] %></td>
        <td><%= row[:kind].tr("_", " ") %><% if row[:kind] == "transfer" %><%= row[:counter_account_name] ? " ↔ #{row[:counter_account_name]}" : "" %><%= row[:transfer_id] ? "" : " (one leg)" %><% end %></td>
        <td class="details"><%= [
          row[:installment_total] && "#{row[:installment_number]}/#{row[:installment_total]}",
          row[:purchased_on] && "bought #{row[:purchased_on]}",
          row[:bank_category], row[:location], row[:counterparty_document]
        ].compact.join(" · ") %></td>
        <td class="num"><%= money(row[:amount_cents]) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
