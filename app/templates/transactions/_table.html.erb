<table class="rows">
  <thead>
    <tr><th>Date</th><th>Account</th><th>Description</th><th>Kind</th><th>Category</th><th>Details</th><th class="num">Amount</th></tr>
  </thead>
  <tbody>
    <% rows.each do |row| %>
      <tr<% if row[:missing_since_import_id] %> class="missing"<% end %>>
        <td><%= row[:occurred_on] %></td>
        <td><%= row[:account_name] %></td>
        <td title="<%= row[:raw_description] %>"><a href="/transactions/<%= row[:id] %>"><%= row[:description] %></a></td>
        <td><%= row[:kind].tr("_", " ") %><% if row[:kind] == "transfer" %><%= row[:counter_account_name] ? " ↔ #{row[:counter_account_name]}" : "" %><%= row[:transfer_id] ? "" : " (one leg)" %><% end %></td>
        <td<% if row[:category_source] == "bank" %> class="suggested" title="the bank's suggestion"<% end %>><%= category_label(row) %></td>
        <td class="details"><%= [
          row[:installment_total] && "#{row[:installment_number]}/#{row[:installment_total]}",
          row[:purchased_on] && "bought #{row[:purchased_on]}",
          row[:bank_category], row[:location], row[:counterparty_document]
        ].compact.join(" · ") %></td>
        <td class="num"><%= money(row[:amount_cents]) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
