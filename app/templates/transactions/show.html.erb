<main>
  <%= render "shared/breadcrumb", parents: [parent_crumb(back, [t("layout.nav.transactions"), "/transactions"], categories)], current: row[:description] %>
  <h1><%= row[:description] %></h1>
  <%= render "transactions/table", rows: [row], categories: nil %>
  <p class="note"><%= t("transactions.show.as_printed", text: row[:raw_description]) %></p>
  <% if row[:counterparty_id] %>
    <p><%= t("transactions.show.counterparty", name: row[:counterparty_name]) %><% if display_name(row) %> <span class="note">(<%= row[:counterparty_bank_name] %>)</span><% end %>
      <% if row[:counterparty_note] %> · <span class="note"><%= row[:counterparty_note] %></span><% end %>
      · <a href="<%= with_back("/counterparties/#{row[:counterparty_id]}") %>"><%= t("counterparties.index.edit") %></a></p>
  <% end %>

  <% unless trips.empty? || row[:kind] == "transfer" %>
    <form action="/trips/rows" method="post" class="filters">
      <%= t("transactions.show.trip") %> <select name="trip_id">
        <% trips.each do |trip| %><option value="<%= trip[:id] %>"><%= trip[:name] %></option><% end %>
      </select>
      <input type="hidden" name="transaction_id" value="<%= row[:id] %>"><input type="hidden" name="back" value="<%= here %>">
      <button type="submit" name="included" value="1"><%= t("transactions.show.add_to_trip") %></button>
      <button type="submit" name="included" value="0"><%= t("transactions.show.take_out_of_trip") %></button>
    </form>
  <% end %>

  <h2><%= t("transactions.show.category_and_memo") %></h2>
  <% if row[:kind] == "transfer" %>
    <p class="note"><%= t("transactions.show.transfer") %></p>
  <% end %>
  <p class="note">
    <% if %w[manual rule bank].include?(row[:category_source]) %><%= t("transactions.show.source.#{row[:category_source]}", category: category_name(row[:category_name])) %>
    <% else %><%= t("transactions.show.source.none") %>
    <% end %>
  </p>
  <form action="/transactions/<%= row[:id] %>" method="post">
    <%= render "transactions/back", back: {back:}.compact %>
    <p><%= render "categories/select", none: nil, name: "category_id", selected: row[:category_source] == "manual" ? row[:category_id] : nil,
          categories: categories, blank: t("transactions.show.automatic"), form: nil %></p>
    <p><label><%= t("transactions.show.memo") %><br><textarea name="memo" rows="2" cols="60"><%= row[:memo] %></textarea></label></p>
    <button type="submit" class="primary"><%= t("common.save") %></button>
  </form>

  <h2><%= t("transactions.adjustment.title") %></h2>
  <% if error_code %><%= render "shared/message", kind: :error, text: t("errors.#{error_code}", default: error_code.to_s) %><% end %>
  <% if row[:refunds_transaction_id] %>
    <p class="note"><%= t("transactions.adjustment.refund_of") %> <a href="<%= transaction_path(row[:refunds_transaction_id]) %>"><%= t("transactions.adjustment.the_purchase") %></a></p>
  <% elsif row[:kind] == "transfer" %>
    <p class="note"><%= t("transactions.adjustment.transfer") %></p>
  <% else %>
    <% if row[:adjustment_kind] %>
      <p><%= t("transactions.adjustment.counts_as", amount: money(row[:counted_cents], row[:currency]), original: money(row[:amount_cents], row[:currency])) %>
        <% if row[:refund_transaction_id] %><a href="<%= transaction_path(row[:refund_transaction_id]) %>"><%= t("transactions.adjustment.the_refund") %></a><% end %></p>
      <% if row[:adjustment_note] %><p class="note"><%= row[:adjustment_note] %></p><% end %>
      <% if purchase_adjustment %>
        <% total = purchase_adjustment[:amount_cents] && money(purchase_adjustment[:amount_cents], row[:currency]) %>
        <p class="note"><%= t("transactions.adjustment.whole_purchase", kind: t("transactions.adjustment.badge.#{purchase_adjustment[:kind]}", amount: total)) %><%= " #{t("transactions.adjustment.purchase_total", amount: total)}" if purchase_adjustment[:kind] == "amount_changed" %></p>
      <% end %>
      <form action="/transactions/<%= row[:id] %>/adjustment/remove" method="post"><%= render "transactions/back", back: {back:}.compact %>
        <% if purchase_adjustment %>
          <button type="submit"><%= t("transactions.adjustment.remove_row") %></button>
          <button type="submit" name="scope" value="purchase"><%= t("transactions.adjustment.remove_purchase") %></button>
        <% else %><button type="submit"><%= t("transactions.adjustment.remove") %></button><% end %>
      </form>
    <% else %>
      <p class="note"><%= t("transactions.adjustment.intro") %></p>
    <% end %>
    <form action="/transactions/<%= row[:id] %>/adjustment" method="post">
      <%= render "transactions/back", back: {back:}.compact %>
      <p>
        <% kinds = row[:amount_cents].negative? ? Tally::Adjustments::KINDS : Tally::Adjustments::KINDS - %w[reimbursed] %>
        <% kinds.each do |kind| %>
          <label><input type="radio" name="kind" value="<%= kind %>"<%= " checked" if row[:adjustment_kind] == kind %>> <%= t("transactions.adjustment.kinds.#{kind}") %></label>
        <% end %>
      </p>
      <% unless installments.empty? %>
        <p>
          <label><input type="radio" name="scope" value="row"<%= " checked" unless purchase_adjustment %>> <%= t("transactions.adjustment.scope.row") %></label>
          <label><input type="radio" name="scope" value="purchase"<%= " checked" if purchase_adjustment %>> <%= t("transactions.adjustment.scope.purchase", total: "#{row[:installment_total]} × #{money(row[:amount_cents].abs, row[:currency])}") %></label>
          <br><span class="note"><%= t("transactions.adjustment.scope.hint") %></span>
        </p>
      <% end %>
      <p><label><%= t("transactions.adjustment.amount") %><br><input name="amount" inputmode="decimal" size="12" value="<%= if purchase_adjustment then purchase_adjustment[:amount_cents] && amount_field(purchase_adjustment[:amount_cents])
          elsif row[:adjustment_cents] && !row[:refund_transaction_id] then amount_field(row[:adjustment_cents].abs) end %>"></label>
        <span class="note"><%= t("transactions.adjustment.amount_hint") %></span></p>
      <% unless refund_candidates.empty? %>
        <p><label><%= t("transactions.adjustment.refund") %><br><select name="refund_id">
          <option value=""><%= t("transactions.adjustment.no_refund") %></option>
          <% refund_candidates.each do |refund| %>
            <option value="<%= refund[:id] %>"<%= " selected" if row[:refund_transaction_id] == refund[:id] %>><%= date(refund[:occurred_on]) %> · <%= refund[:account_name] %> · <%= refund[:description] %> · <%= money(refund[:amount_cents], row[:currency]) %></option>
          <% end %>
        </select></label></p>
      <% end %>
      <p><label><%= t("transactions.adjustment.note") %><br><input name="note" size="60" value="<%= row[:adjustment_note] %>"></label></p>
      <button type="submit" class="primary"><%= t("common.save") %></button>
    </form>
  <% end %>

  <% unless installments.empty? %>
    <h2><%= t("transactions.adjustment.installments") %></h2>
    <%= render "transactions/table", rows: installments, categories: nil %>
  <% end %>
</main>
