<main>
  <h1><%= row[:description] %></h1>
  <%= render "transactions/table", rows: [row] %>
  <p class="note"><%= t("transactions.show.as_printed", text: row[:raw_description]) %></p>

  <h2><%= t("transactions.show.category_and_memo") %></h2>
  <% if row[:kind] == "transfer" %>
    <p class="note"><%= t("transactions.show.transfer") %></p>
  <% end %>
  <p class="note">
    <% if %w[manual rule bank].include?(row[:category_source]) %><%= t("transactions.show.source.#{row[:category_source]}", category: category_name(row[:category_name])) %>
    <% else %><%= t("transactions.show.source.none") %>
    <% end %>
  </p>
  <form action="/transactions/<%= row[:id] %>" method="post">
    <p><%= render "categories/select", name: "category_id", selected: row[:category_source] == "manual" ? row[:category_id] : nil,
          categories: categories, blank: t("transactions.show.automatic"), form: nil %></p>
    <p><label><%= t("transactions.show.memo") %><br><textarea name="memo" rows="2" cols="60"><%= row[:memo] %></textarea></label></p>
    <button type="submit" class="primary"><%= t("common.save") %></button>
  </form>
</main>
