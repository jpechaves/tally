<main>
  <h1><%= t("transactions.index.title") %></h1>
  <form action="/transactions" method="get" class="filters">
    <select name="account">
      <option value=""><%= t("transactions.index.all_accounts") %></option>
      <% accounts.each do |account| %>
        <option value="<%= account.id %>"<%= " selected" if account.id == account_id %>><%= account.name %></option>
      <% end %>
    </select>
    <select name="month">
      <option value=""><%= t("transactions.index.all_months") %></option>
      <% months.each do |value| %>
        <option value="<%= value %>"<%= " selected" if value == month %>><%= month_label(value) %></option>
      <% end %>
    </select>
    <button type="submit"><%= t("common.show") %></button>
  </form>

  <% if rows.empty? %>
    <p><%= t("transactions.index.empty") %></p>
  <% else %>
    <p><%= t("transactions.index.summary", rows: t("common.row_count", count: rows.size), net: money(total_cents)) %></p>
    <%= render "transactions/table", rows: rows %>
  <% end %>
</main>
