<main>
  <% if return_to %><%= render "shared/breadcrumb", parents: [[back_label(return_to, categories), return_to]], current: t("layout.nav.transactions") %><% end %>
  <h1><%= t("transactions.index.title") %></h1>
  <% if changed %><%= render "shared/message", kind: changed.positive? ? :success : :error,
    text: [t("transactions.index.changed", rows: t("common.row_count", count: changed)),
      (t("transactions.index.skipped", count: skipped) if skipped.positive?)].compact.join(" ") %><% end %>
  <form action="<%= Tally::TransactionFilter::PATH %>" method="get" class="filters">
    <input type="search" name="q" value="<%= filter.q %>" placeholder="<%= t("transactions.index.search") %>" maxlength="<%= Tally::TransactionFilter::SEARCH_MAX %>">
    <select name="account" data-picker>
      <option value=""><%= t("transactions.index.all_accounts") %></option>
      <% accounts.each do |account| %>
        <option value="<%= account.id %>"<%= " selected" if account.id == filter.account %>><%= account.name %></option>
      <% end %>
    </select>
    <select name="month" data-picker="values">
      <option value=""><%= t("transactions.index.all_months") %></option>
      <% months.each do |value| %>
        <option value="<%= value %>"<%= " selected" if value == filter.month %>><%= month_label(value) %></option>
      <% end %>
    </select>
    <%= render "categories/select", name: "category", selected: filter.category, categories: categories,
      blank: t("transactions.index.all_categories"), none: t("transactions.index.uncategorized"), form: nil %>
    <select name="kind">
      <option value=""><%= t("transactions.index.all_kinds") %></option>
      <% Tally::TransactionFilter::KINDS.each do |value| %>
        <option value="<%= value %>"<%= " selected" if value == filter.kind %>><%= t("transactions.index.kinds.#{value}") %></option>
      <% end %>
    </select>
    <% filter.carried.each do |key, value| %><input type="hidden" name="<%= key %>" value="<%= value %>"><% end %>
    <%= render "transactions/back", back: {back: return_to}.compact %>
    <button type="submit"><%= t("common.show") %></button>
    <% if filter.any? %><a href="<%= Tally::TransactionFilter::PATH %>"><%= t("transactions.index.clear") %></a><% end %>
  </form>
  <% unless filter.carried.empty? %>
    <p class="filters">
      <% filter.carried.each do |key, value| %>
        <span class="badge"><%= t("transactions.index.carried.#{key}", value: carried_filter_label(key, value, payee: payee_name, purchase: purchase, trip: trip_name, person: person_name)) %>
          <a href="<%= filter.with(key => nil).path %>" title="<%= t("transactions.index.drop") %>" aria-label="<%= t("transactions.index.drop") %>">✕</a></span>
      <% end %>
    </p>
  <% end %>

  <% if purchase %>
    <p class="panel"><% if purchase.left_from(this_month).positive? %><%= t("transactions.index.purchase_left", paid: "#{purchase.number}/#{purchase.total}",
      month: month_label(this_month), left: installments_left(purchase, this_month), ends: month_label(purchase.ends)) %><% else %><%=
      t("transactions.index.purchase_done", paid: "#{purchase.number}/#{purchase.total}", ends: month_label(purchase.ends)) %><% end %></p>
  <% end %>

  <% if rows.empty? %>
    <p><%= filter.any? ? t("transactions.index.no_match") : t("transactions.index.empty") %></p>
  <% else %>
    <% count = t("common.row_count", count: totals[:rows]) %>
    <p><%= t("transactions.index.summary", rows: count) %><% if filter.q %>
      <a href="<%= filter.with(q: nil).path %>"><%= t("transactions.index.clear_search") %></a><% end %></p>
    <div class="cards">
      <% %i[out in].each do |side| %>
        <div><%= t("transactions.index.money_#{side}") %><strong><%= money_each(totals[side]) %></strong><% if totals[:"transfers_#{side}"].values.any?(&:nonzero?) %>
          <span class="note"><%= t("transactions.index.in_transfers", amount: money_each(totals[:"transfers_#{side}"])) %></span><% end %></div>
      <% end %>
      <% if filter.spending? %>
        <div><%= t("transactions.index.spent") %><strong><%= money_each(totals[:net].transform_values(&:-@)) %></strong></div>
      <% else %>
        <div><%= t("transactions.index.balance") %><strong><%= money_each(totals[:net]) %></strong></div>
      <% end %>
    </div>
    <%= render "shared/pages", page: pagination, path: filter.pages(back: return_to) %>
    <form action="/transactions/category" method="post" id="recategorize" class="filters" data-total="<%= totals[:rows] %>"
      data-ask="<%= t("transactions.index.ask", rows: "%{rows}", category: "%{category}") %>" data-one="<%= t("common.row_count", count: 1) %>" data-other="<%= t("common.row_count")[:other] %>">
      <%= t("transactions.index.recategorize") %>
      <%= render "categories/select", name: "category_id", selected: nil, categories: categories, blank: nil, none: nil, form: nil %>
      <% if filter.any? %><label><input type="checkbox" name="all" value="1" data-check-all="recategorize"> <%= t("transactions.index.select_all", count: totals[:rows]) %></label><% end %>
      <%= render "transactions/back", back: back %>
      <button type="submit"><%= t("transactions.index.change_category") %></button>
    </form>
    <%= render "transactions/table", rows: rows, categories: categories, back: back %>
    <%= render "shared/pages", page: pagination, path: filter.pages(back: return_to) %>
    <script src="/assets/table.js"></script>
  <% end %>
</main>
