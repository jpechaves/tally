<main>
  <h1><%= t("transactions.index.title") %></h1>
  <form action="<%= Tally::TransactionFilter::PATH %>" method="get" class="filters">
    <select name="account">
      <option value=""><%= t("transactions.index.all_accounts") %></option>
      <% accounts.each do |account| %>
        <option value="<%= account.id %>"<%= " selected" if account.id == filter.account %>><%= account.name %></option>
      <% end %>
    </select>
    <select name="month">
      <option value=""><%= t("transactions.index.all_months") %></option>
      <% months.each do |value| %>
        <option value="<%= value %>"<%= " selected" if value == filter.month %>><%= month_label(value) %></option>
      <% end %>
    </select>
    <%= render "categories/select", name: "category", selected: filter.category, categories: categories,
      blank: t("transactions.index.all_categories"), none: t("transactions.index.uncategorized"), form: nil %>
    <select name="kind">
      <option value=""><%= t("transactions.index.all_kinds") %></option>
      <% Tally::TransactionFilter::KINDS.each do |value| %>
        <option value="<%= value %>"<%= " selected" if value == filter.kind %>><%= t("transactions.index.kinds.#{value}") %></option>
      <% end %>
    </select>
    <% filter.carried.each do |key, value| %><input type="hidden" name="<%= key %>" value="<%= value %>"><% end %>
    <button type="submit"><%= t("common.show") %></button>
    <% if filter.any? %><a href="<%= Tally::TransactionFilter::PATH %>"><%= t("transactions.index.clear") %></a><% end %>
  </form>
  <% unless filter.carried.empty? %>
    <p class="filters">
      <% filter.carried.each do |key, value| %>
        <span class="badge"><%= t("transactions.index.carried.#{key}", value: carried_filter_label(key, value, payee: payee_name, purchase: purchase)) %>
          <a href="<%= filter.with(key => nil).path %>" title="<%= t("transactions.index.drop") %>" aria-label="<%= t("transactions.index.drop") %>">✕</a></span>
      <% end %>
    </p>
  <% end %>

  <% if purchase %>
    <p class="panel"><% if purchase.left_from(this_month).positive? %><%= t("transactions.index.purchase_left", paid: "#{purchase.number}/#{purchase.total}",
      month: month_label(this_month), left: installments_left(purchase, this_month), ends: month_label(purchase.ends)) %><% else %><%=
      t("transactions.index.purchase_done", paid: "#{purchase.number}/#{purchase.total}", ends: month_label(purchase.ends)) %><% end %></p>
  <% end %>

  <% if rows.empty? %>
    <p><%= t("transactions.index.empty") %></p>
  <% else %>
    <% count = t("common.row_count", count: totals[:rows]) %>
    <p><%= filter.spending? ? t("transactions.index.summary_spent", rows: count, spent: money(-totals[:total_cents])) : t("transactions.index.summary", rows: count, net: money(totals[:total_cents])) %></p>
    <%= render "shared/pages", page: pagination, path: filter.pages %>
    <%= render "transactions/table", rows: rows %>
    <%= render "shared/pages", page: pagination, path: filter.pages %>
  <% end %>
</main>
