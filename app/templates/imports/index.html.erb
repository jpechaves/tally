<main>
  <h1><%= t("imports.index.title") %></h1>
  <p><%= t("imports.index.intro_html") %></p>

  <form action="/imports" method="post" enctype="multipart/form-data" data-busy>
    <input type="file" name="files[]" multiple accept=".csv,.pdf" required>
    <% unless people.one? %>
      <label><%= t("imports.index.whose") %>
        <select name="person">
          <% people.each do |person| %><option value="<%= person.id %>"><%= person.name %></option><% end %>
        </select></label>
    <% end %>
    <button type="submit" class="primary"><%= t("imports.index.import") %></button>
    <%= render "shared/busy", text: t("imports.index.busy") %>
  </form>

  <% if gaps.any? %>
    <h2><%= t("gaps.title") %></h2>
    <ul class="gaps">
      <% gaps.each do |account_id, account_gaps| %>
        <% account_gaps.each do |gap| %>
          <li class="warning"><%= account_names[account_id] %>: <%= gap_label(gap) %></li>
        <% end %>
      <% end %>
    </ul>
    <p class="note"><%= t("gaps.note") %></p>
  <% end %>

  <h2><%= t("imports.index.history") %></h2>
  <% if imports.empty? %>
    <p><%= t("imports.index.empty") %></p>
  <% else %>
    <div class="scroll"><table>
      <thead>
        <tr><th><%= t("imports.index.when") %></th><th><%= t("imports.file") %></th><th><%= t("imports.source") %></th><th><%= t("imports.account") %></th><th><%= t("imports.status") %></th>
          <th class="num"><%= t("imports.new") %></th><th class="num"><%= t("imports.updated") %></th><th class="num"><%= t("imports.unchanged") %></th><th class="num"><%= t("imports.missing") %></th></tr>
      </thead>
      <tbody>
        <% imports.each do |import| %>
          <tr>
            <td><%= timestamp(import.created_at) %></td>
            <td><a href="/imports/<%= import.id %>"><%= import.file_name %></a></td>
            <td><%= source_label(import.source) %></td>
            <td><%= account_names[import.account_id] %></td>
            <td class="status-<%= import.status %>"><%= status_label(:import, import.status) %></td>
            <td class="num"><%= import.rows_inserted %></td>
            <td class="num"><%= import.rows_updated %></td>
            <td class="num"><%= import.rows_unchanged %></td>
            <td class="num"><%= import.rows_missing %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  <% end %>
</main>
