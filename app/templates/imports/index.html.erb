<main>
  <h1>Import statements</h1>
  <p>Nubank account CSV (<code>NU_..._01JUN2026_30JUN2026.csv</code>), Nubank card CSV
    (<code>Nubank_2026-09-09.csv</code>, named after the due date) or Itaú card bill PDF.
    Importing a file again updates its rows instead of duplicating them.</p>

  <form action="/imports" method="post" enctype="multipart/form-data">
    <input type="file" name="files[]" multiple accept=".csv,.pdf" required>
    <button type="submit">Import</button>
  </form>

  <h2>History</h2>
  <% if imports.empty? %>
    <p>Nothing imported yet.</p>
  <% else %>
    <table>
      <thead>
        <tr><th>When</th><th>File</th><th>Source</th><th>Account</th><th>Status</th>
          <th class="num">New</th><th class="num">Updated</th><th class="num">Unchanged</th><th class="num">Missing</th></tr>
      </thead>
      <tbody>
        <% imports.each do |import| %>
          <tr>
            <td><%= timestamp(import.created_at) %></td>
            <td><a href="/imports/<%= import.id %>"><%= import.file_name %></a></td>
            <td><%= source_label(import.source) %></td>
            <td><%= account_names[import.account_id] %></td>
            <td class="status-<%= import.status %>"><%= import.status.tr("_", " ") %></td>
            <td class="num"><%= import.rows_inserted %></td>
            <td class="num"><%= import.rows_updated %></td>
            <td class="num"><%= import.rows_unchanged %></td>
            <td class="num"><%= import.rows_missing %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</main>
