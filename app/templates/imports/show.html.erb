<main>
  <p><a href="/imports">← <%= t("layout.nav.imports") %></a></p>
  <h1><%= import.file_name %></h1>

  <table>
    <tr><th scope="row"><%= t("imports.status") %></th><td class="status-<%= import.status %>"><%= status_label(:import, import.status) %></td></tr>
    <tr><th scope="row"><%= t("imports.source") %></th><td><%= source_label(import.source) %></td></tr>
    <% if account %><tr><th scope="row"><%= t("imports.account") %></th><td><%= account.name %></td></tr><% end %>
    <% if import.period_start %><tr><th scope="row"><%= t("imports.show.period") %></th><td><%= t("common.range", from: date(import.period_start), to: date(import.period_end)) %></td></tr><% end %>
    <tr><th scope="row"><%= t("imports.show.imported") %></th><td><%= timestamp(import.created_at) %></td></tr>
    <tr><th scope="row">SHA-256</th><td><code><%= import.file_sha256 %></code></td></tr>
  </table>

  <% if import.status == "rejected" %>
    <p class="error"><%= t("imports.show.rejected", error: import.error) %></p>
  <% elsif import.status == "duplicate_file" %>
    <p><%= t("imports.show.duplicate_file") %></p>
  <% else %>
    <p><%= t("imports.show.counts_html", new: import.rows_inserted, updated: import.rows_updated, unchanged: import.rows_unchanged, missing: import.rows_missing) %></p>
  <% end %>

  <% if warnings.any? %>
    <h2><%= t("imports.show.warnings") %></h2>
    <ul><% warnings.each do |warning| %><li><%= warning %></li><% end %></ul>
  <% end %>

  <% if missing.any? %>
    <h2><%= t("imports.show.gone") %></h2>
    <p><%= t("imports.show.gone_note") %></p>
    <%= render "transactions/table", rows: missing %>
  <% end %>

  <% if rows.any? %>
    <h2><%= t("imports.show.rows") %></h2>
    <%= render "transactions/table", rows: rows %>
  <% end %>
</main>
