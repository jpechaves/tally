# Ruby / Bundler
/.bundle/
/vendor/bundle
*.gem

# Hanami
.env*.local
/log/*
!/log/.keep
/tmp/
/spec/examples.txt
/coverage/

# Databases (never commit one; the live one holds real data)
/db/*.sqlite
/db/*.sqlite-*
*.sqlite3
*.sqlite3-*

# Personal data: real statements, the live database, backups, local-only rules.
# See docs/architecture.md section 17. Nothing in data/ is ever committed.
/data/*
!/data/README.md
/storage/

# Statement files only belong in git as synthetic fixtures.
*.csv
*.pdf
*.ofx
!/spec/fixtures/**/*.csv
!/spec/fixtures/**/*.pdf
!/spec/fixtures/**/*.ofx
