# Installed by deploy/pi/setup.sh when TALLY_NAME is set; @...@ are filled in there.
[Unit]
Description=Tally's name on the network (@NAME@.local)
After=avahi-daemon.service network-online.target
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
User=@USER@
ExecStart=/usr/local/bin/tally-publish-name @NAME@
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
